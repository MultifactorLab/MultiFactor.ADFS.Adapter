  <!-- Merge Serilog dependencies into the strong-named adapter assembly so a single DLL goes
       into the GAC. Serilog.Sinks.Syslog is not strong-named and cannot be GAC'd on its own,
       which makes merging required. Runs on Windows for Release builds (CI). -->
  <PropertyGroup>
    <!-- $(PkgILRepack) is generated by NuGet restore (GeneratePathProperty) and points at the
         restored ILRepack package in the global cache - no hard-coded path or version. -->
    <ILRepackExe>$(PkgILRepack)/tools/ILRepack.exe</ILRepackExe>
    <!-- On non-Windows the exe is launched through Mono; on Windows it runs directly. -->
    <ILRepackLauncher Condition="'$(OS)' != 'Windows_NT'">mono </ILRepackLauncher>
  </PropertyGroup>
  <Target Name="ILRepackMerge" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec WorkingDirectory="$(OutDir)"
          Command="$(ILRepackLauncher)&quot;$(ILRepackExe)&quot; /internalize /ndebug /keyfile:&quot;$(ProjectDir)SigningKey.snk&quot; /out:merged/$(TargetFileName) $(TargetFileName) Serilog.dll Serilog.Sinks.EventLog.dll Serilog.Sinks.File.dll Serilog.Sinks.PeriodicBatching.dll Serilog.Sinks.Syslog.dll" />
    <Copy SourceFiles="$(OutDir)merged/$(TargetFileName)" DestinationFiles="$(OutDir)$(TargetFileName)" OverwriteReadOnlyFiles="true" />
    <ItemGroup>
      <MergedLeftovers Include="$(OutDir)Serilog*.dll;$(OutDir)Serilog*.xml;$(OutDir)Serilog*.pdb;$(OutDir)System.Runtime.InteropServices.RuntimeInformation.*" />
    </ItemGroup>
    <Delete Files="@(MergedLeftovers)" />
    <RemoveDir Directories="$(OutDir)merged" />
  </Target>
